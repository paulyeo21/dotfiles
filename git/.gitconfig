[user]
	name = Paul Yeo
	email = paulyeo21@gmail.com
[core]
	editor = vim
	excludesfile = ~/.gitignore_global
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
	light = false
	file-style = bold yellow ul
	file-decoration-style = yellow ol
	file-modified-label = modified:
	hunk-header-decoration-style = cyan box ul
	hunk-header-line-number-style = "#067a00"
	syntax-theme = Monokai Extended
	pager = less -+F -X -R
[pager]
  branch = false
[diff]
	algorithm = histogram
	colorMoved = zebra
	colorMovedWS = allow-indentation-change
	mnemonicPrefix = true
	renames = copies
	interHunkContext = 3
	context = 5
	submodule = log
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
	autoupdate = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[filter "lfs"]
	required = true
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
[alias]
  # ── Status & diff ──────────────────────────────────────────────────────
  st        = status
  d         = diff
  dc        = diff --cached

  # ── Staging & committing ───────────────────────────────────────────────
  aa        = add --all
  uncommit  = reset --soft HEAD^

  # ── Branching ──────────────────────────────────────────────────────────
  co        = checkout
  b         = branch
  del       = branch -D
  delr      = push origin --delete
  rename    = branch -m

  # ── Fetching & syncing ─────────────────────────────────────────────────
  f         = fetch
  pru       = "!sh -c 'git fetch --prune && git branch --merged | grep -vE \"^\\*|main|master\" | xargs -r git branch -d && git branch -vv | awk \"/: gone]/{print \\$1}\" | xargs -r git branch -D'"
  mup       = "!git checkout $(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||' || echo main) && git pull && git checkout -"
  reseto    = reset --hard @{upstream}

  # ── Remotes ────────────────────────────────────────────────────────────
  rv        = remote -v

  # ── Log & history ──────────────────────────────────────────────────────
  vlog      = log --graph --pretty=format:'commit: %C(bold red)%h%Creset %C(red)<%H>%Creset %C(bold magenta)%d %Creset%ndate: %C(bold yellow)%cd %Creset%C(yellow)%cr%Creset%nauthor: %C(bold blue)%an%Creset %C(blue)<%ae>%Creset%n%C(cyan)%s%n%Creset'
  glog      = log -E -i --grep
[push]
	default = upstream
[init]
	templatedir = ~/.git_template
